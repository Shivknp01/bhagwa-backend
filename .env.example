# ==============================================================================
# BHAGWA BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PUBLIC (Client Side: Flutter App & Next.js Admin)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# SERVER ONLY (NEVER expose to Client, Flutter App, or Browser JavaScript!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 MEDIA STORAGE (SERVER / EDGE FUNCTIONS ONLY)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=bhagwa-media
R2_PUBLIC_BASE_URL=https://media.bhagwa.app

# ------------------------------------------------------------------------------
# 3. FIREBASE CLOUD MESSAGING (FCM - SERVER / EDGE FUNCTIONS ONLY)
# ------------------------------------------------------------------------------
FCM_SERVER_KEY=your-firebase-fcm-server-key
